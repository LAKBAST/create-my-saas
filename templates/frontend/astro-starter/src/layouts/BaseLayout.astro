---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { PRODUCT_NAME } from '../lib/brand';
import { appNavigation } from '../lib/navigation';

interface Props {
  /** Page name; the product name is appended unless the page is the product itself. */
  title: string;
  description: string;
  protected?: boolean;
  noindex?: boolean;
  /** Renders only the page, without the site header or the app shell (sign-in pages). */
  bare?: boolean;
}

const { title: pageTitle, description, protected: protectedPage = false, noindex = false, bare = false } = Astro.props;
const title = pageTitle === PRODUCT_NAME ? pageTitle : `${pageTitle} | ${PRODUCT_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const robots = protectedPage || noindex ? 'noindex, nofollow, noarchive' : 'index, follow';
const current = appNavigation.find((item) => item.href === Astro.url.pathname);
const initial = PRODUCT_NAME.slice(0, 1);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body data-protected={protectedPage ? '' : undefined}>
    {protectedPage ? (
      <div class="app">
        <aside class="sidebar" data-mobile-menu>
          <a class="brand" href="/app/"><span class="brand-mark" aria-hidden="true">{initial}</span>{PRODUCT_NAME}</a>
          <nav id="main-navigation" aria-label="Navegación principal">
            <p class="nav-label">Menú</p>
            {appNavigation.map((item) => <a href={item.href} aria-current={item === current ? 'page' : undefined}><Icon name={item.icon} />{item.label}</a>)}
          </nav>
          <div class="sidebar-user">
            <a href="/account/" class="avatar" aria-label="Abrir cuenta" data-user-initials></a>
            <div><strong data-user-name></strong><small data-user-email></small></div>
            <button type="button" class="icon-button" data-logout aria-label="Cerrar sesión" title="Cerrar sesión"><Icon name="logout" /></button>
          </div>
        </aside>
        <button type="button" class="backdrop" data-mobile-menu-button aria-label="Cerrar menú"></button>
        <div class="app-main">
          <header class="app-header">
            <button class="menu-button" type="button" data-mobile-menu-button aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir menú"><Icon name="menu" /></button>
            <p class="crumb"><span>{PRODUCT_NAME}</span>{current && <><i aria-hidden="true">/</i><strong>{current.label}</strong></>}</p>
            <span class="session"><span class="status-dot"></span>Sesión activa</span>
          </header>
          <main class="app-content"><slot /></main>
        </div>
      </div>
    ) : bare ? <slot /> : (
      <div class="site">
        <header class="site-header">
          <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">{initial}</span>{PRODUCT_NAME}</a>
          <button class="menu-button" type="button" data-mobile-menu-button aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir menú"><Icon name="menu" /></button>
          <nav id="main-navigation" data-mobile-menu aria-label="Navegación principal">
            <a href="/pricing">Precios</a>
            <a href="/docs">Documentación</a>
            <a href="/blog">Blog</a>
            <a class="btn btn-ghost" href="/login/">Iniciar sesión</a>
            <a class="btn btn-primary" href="/register/">Crear cuenta</a>
          </nav>
        </header>
        <main class="site-main"><slot /></main>
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} {PRODUCT_NAME}</span>
          <a href="/docs">Documentación</a>
          <a href="/blog">Blog</a>
        </footer>
      </div>
    )}
    <script>
      import '../scripts/auth';
      import { initializePostHog } from '../scripts/posthog';
      document.addEventListener('DOMContentLoaded', initializePostHog);
    </script>
  </body>
</html>
