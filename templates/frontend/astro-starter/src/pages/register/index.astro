---
import AuthPage from '../../components/AuthPage.astro';
---
<AuthPage title="Crear cuenta" description="Crea la cuenta de tu producto.">
  <h1>Crea tu cuenta</h1><p>Empieza con la base de tu nuevo producto.</p>
  <form data-auth-form="register"><label>Nombre<input name="name" autocomplete="name" placeholder="Tu nombre" required /></label><label>Correo electrónico<input name="email" type="email" autocomplete="email" placeholder="tu@empresa.com" required /></label><label>Contraseña<input name="password" type="password" autocomplete="new-password" placeholder="8 caracteres, letra y número" minlength="8" required /></label><p data-form-status class="form-status" role="status"></p><button type="submit">Crear cuenta</button></form>
  <div class="oauth" data-oauth hidden><p class="divider">o continúa con</p><p data-oauth-status class="form-status" role="status"></p><div class="oauth-actions"><button type="button" class="secondary-button" data-oauth-provider="google">Google</button><button type="button" class="secondary-button" data-oauth-provider="github">GitHub</button></div></div>
  <p class="form-footer">¿Ya tienes cuenta? <a href="/login/">Iniciar sesión</a></p>
</AuthPage>
