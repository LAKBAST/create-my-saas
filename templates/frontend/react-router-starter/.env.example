# Server-only backend origin used by the same-origin React Router proxy.
# Nest: configure PORT=3001 in templates/backend/nestjs-starter/.env.
# FastAPI: http://localhost:8000.
API_PROXY_TARGET=http://localhost:3001

# Public canonical URL used by metadata, robots.txt, and sitemap.xml.
VITE_PUBLIC_SITE_URL=https://example.com

# Keep this aligned with the cookie name configured by the selected backend.
VITE_CSRF_COOKIE_NAME=csrf_token

# Product analytics is inactive until both values are set. Use the ingestion
# endpoint from your PostHog project; no email, name, token or private content
# is sent by this starter.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Published policy URLs shown in the optional analytics consent notice.
# Use HTTPS URLs or same-site paths to existing pages; blank values hide the links.
VITE_PRIVACY_POLICY_URL=
VITE_COOKIE_POLICY_URL=
