---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { docsNav, docUrl, site } from '../data/site';
import { langs, lp, ui } from '../data/i18n';

// Cada página se publica en español en /<ruta>/ y su traducción en /en/<ruta en inglés>/.
export async function getStaticPaths() {
	const entries = await getCollection('docs');
	const byId = new Map(entries.map((entry) => [entry.id, entry]));
	return langs.flatMap((lang) => {
		const other = langs.find((code) => code !== lang)!;
		const id = (page: (typeof docsNav)[number]['items'][number]) => lp(lang, page[lang]);
		const order = docsNav.flatMap((group) => group.items.map((page) => ({ page, group: group.label[lang] })));
		for (const { page } of order) {
			if (!byId.has(id(page))) throw new Error(`El índice cita "${id(page)}", pero no existe src/content/docs/${id(page)}.md`);
		}
		const link = (page: (typeof order)[number]['page']) => ({ href: docUrl(lang, page), title: byId.get(id(page))!.data.title });
		return order.map(({ page, group }, index) => ({
			params: { slug: id(page) },
			props: {
				lang,
				entry: byId.get(id(page))!,
				group,
				alternate: lp(other, `${page[other]}/`),
				prev: order[index - 1] && link(order[index - 1].page),
				next: order[index + 1] && link(order[index + 1].page),
				nav: docsNav.map((navGroup) => ({
					label: navGroup.label[lang],
					items: navGroup.items.map((item) => ({ ...link(item), current: item === page })),
				})),
			},
		}));
	});
}

const { lang, entry, group, alternate, prev, next, nav } = Astro.props;
const t = ui[lang];
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const editUrl = entry.data.editUrl ?? `${site.repo}/edit/main/website/${entry.filePath}`;
---

<Base title={entry.data.title} description={entry.data.description} alternate={alternate}>
	<div class="shell docs">
		<aside class="docs-sidebar" aria-label={t.docs}>
			<nav class="docs-nav-groups">
				{nav.map((navGroup) => (
					<div class="docs-nav-group">
						<span>{navGroup.label}</span>
						<ul>
							{navGroup.items.map((item) => (
								<li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.title}</a></li>
							))}
						</ul>
					</div>
				))}
			</nav>
		</aside>

		<article>
			<details class="docs-nav-mobile" data-docs-nav>
				<summary>
					<span class="docs-nav-mobile-label">
						<small>{group}</small>
						<span>{entry.data.title}</span>
					</span>
					<span class="docs-nav-mobile-action">{t.index} <span class="plus-icon" aria-hidden="true"></span></span>
				</summary>
				<div class="docs-nav-mobile-panel">
				{toc.length > 0 && (
					<div class="docs-nav-group docs-nav-toc">
						<span>{t.onThisPage}</span>
						<ul>
							{toc.filter((heading) => heading.depth === 2).map((heading) => (
								<li><a href={`#${heading.slug}`}>{heading.text}</a></li>
							))}
						</ul>
					</div>
				)}
				<nav class="docs-nav-groups" aria-label={t.docs}>
					{nav.map((navGroup) => (
						<div class="docs-nav-group">
							<span>{navGroup.label}</span>
							<ul>
								{navGroup.items.map((item) => (
									<li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.title}</a></li>
								))}
							</ul>
						</div>
					))}
				</nav>
				</div>
			</details>

			<header class="docs-header" data-pagefind-body>
				<span class="eyebrow" data-pagefind-meta="group">{group}</span>
				<h1>{entry.data.title}</h1>
				{entry.data.description && <p>{entry.data.description}</p>}
			</header>

			<div class="prose" data-pagefind-body>
				<Content />
			</div>

			<a class="docs-edit" href={editUrl} target="_blank" rel="noopener">
				<div>
					<strong>{t.editTitle}</strong>
					<span>{t.editText}</span>
				</div>
				<span class="arrow" aria-hidden="true">↗</span>
			</a>

			<nav class="docs-pager" aria-label={t.pagination}>
				{prev && <a class="prev" href={prev.href}><small>{t.prev}</small><span>{prev.title}</span></a>}
				{next && <a class="next" href={next.href}><small>{t.next}</small><span>{next.title}</span></a>}
			</nav>
		</article>

		{toc.length > 0 && (
			<aside class="docs-toc" aria-label={t.onThisPage}>
				<span>{t.onThisPage}</span>
				<ul>
					{toc.map((heading) => (
						<li><a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a></li>
					))}
				</ul>
			</aside>
		)}
	</div>
</Base>

<script>
	import { ui, type Lang } from '../data/i18n';

	// Las tablas anchas se desplazan dentro de su caja en lugar de desbordar la
	// página. Cada celda guarda el nombre de su columna para que, en móvil, las
	// filas se lean como fichas.
	for (const table of document.querySelectorAll('.prose table')) {
		const wrap = document.createElement('div');
		wrap.className = 'table-wrap';
		table.replaceWith(wrap);
		wrap.append(table);
		const labels = [...table.querySelectorAll('thead th')].map((th) => th.textContent?.trim() ?? '');
		for (const row of table.querySelectorAll('tbody tr')) {
			[...row.children].forEach((cell, index) => cell.setAttribute('data-label', labels[index] ?? ''));
		}
	}

	// En móvil, el índice se cierra al elegir un destino.
	const docsNav = document.querySelector<HTMLDetailsElement>('[data-docs-nav]');
	docsNav?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) docsNav.open = false;
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && docsNav?.open) docsNav.open = false;
	});

	// Enlace a cada sección, visible al pasar por encima del título.
	for (const heading of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]')) {
		const anchor = document.createElement('a');
		anchor.className = 'heading-anchor';
		anchor.href = `#${heading.id}`;
		anchor.textContent = '#';
		anchor.setAttribute('aria-label', (ui[document.documentElement.lang as Lang] ?? ui.es).sectionLink);
		heading.append(anchor);
	}

	// Marca en el índice la sección que se está leyendo.
	const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.docs-toc a')].map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
	if (links.size && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			const visible = entries.filter((entry) => entry.isIntersecting);
			if (!visible.length) return;
			for (const link of links.values()) link.classList.remove('is-active');
			links.get(visible[0].target.id)?.classList.add('is-active');
		}, { rootMargin: '0px 0px -70% 0px' });
		for (const id of links.keys()) {
			const heading = document.getElementById(id);
			if (heading) observer.observe(heading);
		}
	}
</script>
