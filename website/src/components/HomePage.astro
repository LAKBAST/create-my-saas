---
import Base from '../layouts/Base.astro';
import SplitText from './SplitText.astro';
import { docLinks, docUrl, site, url } from '../data/site';
import { lp, type Lang } from '../data/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const content = {
	es: {
		eyebrow: 'CLI open source · por LAKBAST',
		group: 'Inicio',
		title: ['Tu próximo SaaS,', 'sin empezar de cero.'],
		lead: 'Autenticación, equipos, billing y panel de administración ya resueltos. Eliges backend y frontend; la CLI compone el resto.',
		start: 'Empezar en 5 minutos',
		github: 'Ver en GitHub',
		copy: 'Copiar',
		featuresEyebrow: '01 / Qué incluye',
		featuresTitle: 'Lo que cada SaaS necesita y nadie quiere reconstruir.',
		featuresIntro: 'Cada plantilla es un proyecto independiente y sustituible. El código generado es tuyo, sin dependencias de la CLI.',
		features: [
			{ title: 'Autenticación', text: 'Sesiones seguras de navegador con CSRF, verificación de email, recuperación de cuenta y OAuth con Google y GitHub.' },
			{ title: 'Equipos y permisos', text: 'Organizaciones, invitaciones, roles y RBAC, con audit log. Producto individual, de equipos o mixto.' },
			{ title: 'Billing', text: 'Stripe Checkout, Portal y webhooks, deshabilitados de forma segura hasta que configuras tus claves.' },
			{ title: 'Administración', text: 'Panel global en /admin con estadísticas y búsqueda de usuarios, organizaciones y suscripciones.' },
			{ title: 'Despliegue', text: 'PostgreSQL con migraciones, Redis para límites de peticiones y una receta con Docker Compose lista para producción.' },
			{ title: 'Actualizaciones', text: 'upgrade fusiona las mejoras de cada nueva versión con tus cambios, archivo a archivo, como un merge de git.' },
		],
		stackEyebrow: '02 / Elige tu stack',
		stackTitle: 'Tres backends. Tres frontends.',
		stackIntro: 'La CLI compara las capacidades que declara cada plantilla antes de escribir un solo archivo, y solo combina lo que funciona.',
		swipe: 'Desliza →',
		backends: [
			{ id: 'fastapi', name: 'FastAPI', meta: 'Backend · Python', text: 'API completa: usuarios, organizaciones, RBAC, audit log, OAuth y billing.' },
			{ id: 'nestjs', name: 'NestJS', meta: 'Backend · TypeScript', text: 'API modular con el mismo contrato funcional que FastAPI.' },
			{ id: 'fastify', name: 'Fastify', meta: 'Backend · TypeScript', text: 'API ligera con sesiones, verificación y OAuth. Producto individual, sin billing.' },
		],
		frontends: [
			{ id: 'nextjs', name: 'Next.js', meta: 'Frontend · React', text: 'Dashboard con rutas protegidas y todos los flujos de cuenta.' },
			{ id: 'react-router', name: 'React Router', meta: 'Frontend · React', text: 'Dashboard en Framework Mode con renderizado en servidor y proxy same-origin.' },
			{ id: 'astro', name: 'Astro', meta: 'Frontend · Astro', text: 'Sitio de marketing, documentación y blog con zona autenticada ligera.' },
		],
		stackNote: 'Next.js y React Router requieren FastAPI o NestJS. Astro funciona con los tres backends.',
		stepsEyebrow: '03 / Cómo funciona',
		stepsTitle: 'De la terminal a tu producto en cuatro pasos.',
		steps: [
			{ title: 'Genera', text: 'Elige backend y frontend. La CLI comprueba que sean compatibles.' },
			{ title: 'Configura', text: 'Crea los .env locales con secretos de desarrollo y URLs correctas.' },
			{ title: 'Arranca', text: 'PostgreSQL, Redis, migraciones, API y frontend con Docker Compose.' },
			{ title: 'Construye', text: 'Carga datos de demo y empieza a desarrollar tu producto.' },
		],
		proTitle: '¿Necesitas más? Hay módulos Pro.',
		proIntro: 'Claves API, tareas en segundo plano, facturación por uso, almacenamiento, observabilidad y más, sobre Community. Siete módulos y soporte prioritario desde 29 € al mes, IVA incluido.',
		proLink: 'Ver create-my-saas Pro',
		ctaEyebrow: 'Empieza hoy',
		ctaTitle: 'Dedica tu tiempo a lo que hace único a tu producto.',
		ctaStart: 'Ir al quick start',
		ctaDocs: 'Leer la documentación',
	},
	en: {
		eyebrow: 'Open source CLI · by LAKBAST',
		group: 'Home',
		title: ['Your next SaaS,', 'without starting from scratch.'],
		lead: 'Authentication, teams, billing and an admin dashboard, already solved. You pick the backend and frontend; the CLI puts the rest together.',
		start: 'Get started in 5 minutes',
		github: 'View on GitHub',
		copy: 'Copy',
		featuresEyebrow: '01 / What’s included',
		featuresTitle: 'What every SaaS needs and nobody wants to rebuild.',
		featuresIntro: 'Each template is an independent, replaceable project. The generated code is yours, with no dependency on the CLI.',
		features: [
			{ title: 'Authentication', text: 'Secure browser sessions with CSRF, email verification, account recovery and OAuth with Google and GitHub.' },
			{ title: 'Teams and permissions', text: 'Organizations, invitations, roles and RBAC, with an audit log. Individual, teams or mixed product.' },
			{ title: 'Billing', text: 'Stripe Checkout, Portal and webhooks, safely disabled until you configure your keys.' },
			{ title: 'Administration', text: 'Global dashboard at /admin with statistics and search across users, organizations and subscriptions.' },
			{ title: 'Deployment', text: 'PostgreSQL with migrations, Redis for rate limiting and a production-ready Docker Compose recipe.' },
			{ title: 'Upgrades', text: 'upgrade merges each new version’s improvements with your changes, file by file, like a git merge.' },
		],
		stackEyebrow: '02 / Choose your stack',
		stackTitle: 'Three backends. Three frontends.',
		stackIntro: 'The CLI compares the capabilities each template declares before writing a single file, and only combines what works.',
		swipe: 'Swipe →',
		backends: [
			{ id: 'fastapi', name: 'FastAPI', meta: 'Backend · Python', text: 'Full API: users, organizations, RBAC, audit log, OAuth and billing.' },
			{ id: 'nestjs', name: 'NestJS', meta: 'Backend · TypeScript', text: 'Modular API with the same functional contract as FastAPI.' },
			{ id: 'fastify', name: 'Fastify', meta: 'Backend · TypeScript', text: 'Lightweight API with sessions, verification and OAuth. Individual product, no billing.' },
		],
		frontends: [
			{ id: 'nextjs', name: 'Next.js', meta: 'Frontend · React', text: 'Dashboard with protected routes and every account flow.' },
			{ id: 'react-router', name: 'React Router', meta: 'Frontend · React', text: 'Framework Mode dashboard with server rendering and a same-origin proxy.' },
			{ id: 'astro', name: 'Astro', meta: 'Frontend · Astro', text: 'Marketing, docs and blog site with a light authenticated area.' },
		],
		stackNote: 'Next.js and React Router require FastAPI or NestJS. Astro works with all three backends.',
		stepsEyebrow: '03 / How it works',
		stepsTitle: 'From the terminal to your product in four steps.',
		steps: [
			{ title: 'Generate', text: 'Pick a backend and a frontend. The CLI checks that they are compatible.' },
			{ title: 'Configure', text: 'Create the local .env files with development secrets and the right URLs.' },
			{ title: 'Start', text: 'PostgreSQL, Redis, migrations, API and frontend with Docker Compose.' },
			{ title: 'Build', text: 'Load demo data and start developing your product.' },
		],
		proTitle: 'Need more? There are Pro modules.',
		proIntro: 'API keys, background jobs, usage-based billing, storage, observability and more, on top of Community. Seven modules and priority support from €29 a month, VAT included.',
		proLink: 'See create-my-saas Pro',
		ctaEyebrow: 'Start today',
		ctaTitle: 'Spend your time on what makes your product unique.',
		ctaStart: 'Go to the quick start',
		ctaDocs: 'Read the docs',
	},
}[lang];

const commands = [
	site.command,
	'npx @lakbast/create-my-saas@latest setup',
	'docker compose … up --build api frontend',
	'npx @lakbast/create-my-saas@latest seed',
];
const quickStart = docUrl(lang, docLinks.quickStart);
const templates = docUrl(lang, docLinks.templates);
const [first, second] = content.title;
---

<Base title={site.name} alternate={lp(lang === 'es' ? 'en' : 'es')}>
	<section data-pagefind-body class="shell hero">
		<span class="eyebrow" data-pagefind-meta={`group:${content.group}`}>{content.eyebrow}</span>
		<div class="hero-grid">
			<h1 data-pagefind-meta="title:create-my-saas"><SplitText text={first} /> <em><SplitText text={second} start={first.split(' ').length} /></em></h1>
			<div class="hero-side">
				<p class="lead">{content.lead}</p>
				<div class="hero-actions">
					<a class="button" href={quickStart}>{content.start} <span aria-hidden="true">→</span></a>
					<a class="arrow-link" href={site.repo}>{content.github} <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</div>
	</section>

	<div class="shell hero-command">
		<div class="command">
			<code><b aria-hidden="true">$</b>{site.command}</code>
			<button class="copy-button" type="button" data-copy={site.command}>{content.copy}</button>
		</div>
	</div>

	<section data-pagefind-body class="shell section" style="margin-top: clamp(64px, 7vw, 96px)">
		<div class="section-head">
			<span class="eyebrow">{content.featuresEyebrow}</span>
			<div>
				<h2>{content.featuresTitle}</h2>
				<p class="section-intro">{content.featuresIntro}</p>
			</div>
		</div>
		<div class="feature-list">
			{content.features.map((feature, index) => (
				<article class="feature-row">
					<span class="feature-num">{String(index + 1).padStart(2, '0')}</span>
					<h3>{feature.title}</h3>
					<p>{feature.text}</p>
				</article>
			))}
		</div>
	</section>

	<div class="dark-panel">
		<section data-pagefind-body class="shell section">
			<div class="section-head">
				<span class="eyebrow">{content.stackEyebrow}</span>
				<div>
					<h2>{content.stackTitle}</h2>
					<p class="section-intro">{content.stackIntro}</p>
				</div>
			</div>
			<p class="stack-label">Backend <span class="swipe-hint" aria-hidden="true">{content.swipe}</span></p>
			<div class="stack-grid">
				{content.backends.map((item) => (
					<a class="stack-card" href={templates}>
						<span class="meta">{item.meta}</span>
						<div><h3>{item.name}</h3><p>{item.text}</p></div>
						<code>--backend {item.id}</code>
					</a>
				))}
			</div>
			<p class="stack-label">Frontend <span class="swipe-hint" aria-hidden="true">{content.swipe}</span></p>
			<div class="stack-grid">
				{content.frontends.map((item) => (
					<a class="stack-card" href={templates}>
						<span class="meta">{item.meta}</span>
						<div><h3>{item.name}</h3><p>{item.text}</p></div>
						<code>--frontend {item.id}</code>
					</a>
				))}
			</div>
			<p class="note">{content.stackNote}</p>
		</section>
	</div>

	<section data-pagefind-body class="shell section">
		<div class="section-head">
			<span class="eyebrow">{content.stepsEyebrow}</span>
			<div>
				<h2>{content.stepsTitle}</h2>
			</div>
		</div>
		<ol class="step-grid">
			{content.steps.map((step, index) => (
				<li class="step">
					<span class="feature-num">{String(index + 1).padStart(2, '0')}</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
					<code>{commands[index]}</code>
				</li>
			))}
		</ol>
	</section>

	<section data-pagefind-body class="shell section">
		<div class="section-head">
			<span class="eyebrow">04 / Pro</span>
			<div>
				<h2>{content.proTitle}</h2>
				<p class="section-intro">{content.proIntro}</p>
				<div class="hero-actions" style="margin-top: 32px">
					<a class="button" href={url(lp(lang, 'pro/'))}>{content.proLink} <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</div>
	</section>

	<section data-pagefind-body class="shell section cta">
		<span class="eyebrow">{content.ctaEyebrow}</span>
		<h2>{content.ctaTitle}</h2>
		<div class="hero-actions">
			<a class="button" href={quickStart}>{content.ctaStart} <span aria-hidden="true">→</span></a>
			<a class="arrow-link" href={docUrl(lang, docLinks.home)}>{content.ctaDocs} <span aria-hidden="true">→</span></a>
		</div>
	</section>
</Base>
